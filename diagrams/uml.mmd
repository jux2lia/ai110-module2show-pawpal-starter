classDiagram
    class Owner {
        +str name
        +int available_minutes
        +list~Pet~ pets
        +add_pet(pet: Pet) None
        +get_all_tasks() list~Task~
    }

    class Pet {
        +str name
        +str species
        +list~Task~ tasks
        +add_task(task: Task) None
        +edit_task(title: str, duration: int, priority: str) None
    }

    class Task {
        +str title
        +int duration_minutes
        +str priority
        +bool completed
        +mark_complete() None
    }

    class Scheduler {
        +Owner owner
        +generate_plan() list~Task~
        +explain_plan() str
    }

    Owner "1" --> "0..*" Pet : has
    Pet "1" --> "0..*" Task : has
    Scheduler --> Owner : uses
